#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define NAV 4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};

/  {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Esc, but Cmd+Esc sends Cmd+` so app/window cycling sits on Tab/Esc like a normal keyboard's Tab/`
        esc_grave: esc_grave {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
            keep-mods = <(MOD_LGUI|MOD_RGUI)>;
        };
    };

    keymap {
            compatible = "zmk,keymap";

            default_layer {
// -----------------------------------------------------------------------------------------
// | TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | ESC* |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | CAPS |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |DICT  |
//                    |LOWER|SPC-N|BKS-G|   | ENT |SPC-N |RAISE|
// ESC* = Esc, Cmd+Esc sends Cmd+`.  DICT = Ctrl+Opt for Wispr Flow.  Home row: Ctrl Alt Shift Cmd.

                        bindings = <
   &kp TAB    &kp Q       &kp W      &kp E       &kp R         &kp T          &kp Y         &kp U          &kp I         &kp O        &kp P          &kp BSPC
   &esc_grave &hm LCTRL A &hm LALT S &hm LSHFT D &hm LGUI F    &kp G          &kp H         &hm RGUI J     &hm RSHFT K   &hm RALT L   &hm RCTRL SEMI &kp SQT
   &kp CAPS   &kp Z       &kp X      &kp C       &kp V         &kp B          &kp N         &kp M          &kp COMMA     &kp DOT      &kp FSLH       &kp LC(LALT)
                                    &mo LOWER   &lt NAV SPACE &hm LGUI BSPC  &kp RET       &lt NAV SPACE  &mo RAISE
                        >;
            };

            lower_layer {
// -----------------------------------------------------------------------------------------
// |  ~   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | DEL  |
// | DEL  | F1  | F2  | F3  | F4  | F5  |   | F6  |  _  |  +  |  {  |  }  |  |   |
// |      | F7  | F8  | F9  | F10 | F11 |   | F12 |SHOT |     |HOME | END |      |
//                    |     |     |     |   |     |     |     |
// SHOT = Cmd+Shift+4 screenshot

                        bindings = <
   &kp TILDE &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp DEL
   &kp DEL   &kp F1   &kp F2 &kp F3   &kp F4   &kp F5      &kp F6    &kp UNDER &kp PLUS        &kp LBRC &kp RBRC &kp PIPE
   &trans    &kp F7   &kp F8 &kp F9   &kp F10  &kp F11     &kp F12   &kp LG(LS(N4)) &trans     &kp HOME &kp END  &trans
                    	     &trans   &trans   &trans      &trans    &trans    &trans
                        >;
            };

            raise_layer {
// -----------------------------------------------------------------------------------------
// |   `  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | DEL  |
// | DEL  | F1  | F2  | F3  | F4  | F5  |   | F6  |  -  |  =  |  [  |  ]  |  \   |
// |      | F7  | F8  | F9  | F10 | F11 |   | F12 | REC |     |HOME | END |      |
//                    |     |     |     |   |     |     |     |
// REC = Cmd+Shift+5 screen recording

                        bindings = <
   &kp GRAVE &kp N1   &kp N2 &kp N3   &kp N4   &kp N5      &kp N6    &kp N7    &kp N8    &kp N9    &kp N0   &kp DEL
   &kp DEL   &kp F1   &kp F2 &kp F3   &kp F4   &kp F5      &kp F6    &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH
   &trans    &kp F7   &kp F8 &kp F9   &kp F10  &kp F11     &kp F12   &kp LG(LS(N5)) &trans &kp HOME  &kp END  &trans
                    	     &trans   &trans   &trans      &trans    &trans    &trans
                        >;
            };

            adjust_layer {
// -----------------------------------------------------------------------------------------
// |RESET | BT1 | BT2 | BT3 | BT4 | BT5 |   |BTCLR|     |     |     |     |RESET |
// |      |     |     |     |     |     |   |     |     |     |     |     |      | 
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
                        bindings = <
   &bootloader  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &bt BT_CLR   &bt BT_CLR_ALL &trans &ext_power EP_TOG &trans &bootloader
   &trans       &trans       &trans       &trans       &trans       &trans         &trans       &trans  &trans  &trans  &trans  &trans
   &trans       &trans       &trans       &trans       &trans       &trans         &trans       &trans  &trans  &trans  &trans  &trans
                          	              &trans       &trans       &trans         &trans       &trans  &trans
                        >;
            };

            nav_layer {
// ------------------------------------------------------------------f-----------------------
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
                        bindings = <
   &trans    &trans    &trans    &trans   &trans    &trans     &trans   &trans    &trans    &trans  &trans     &trans
   &trans    &trans    &trans    &trans   &trans    &trans     &trans   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
   &trans    &trans    &trans    &trans   &trans    &trans     &trans   &trans    &trans    &trans  &trans     &trans
                                 &trans    &trans   &trans     &trans   &trans    &trans
                        >;
            };
        };
};
