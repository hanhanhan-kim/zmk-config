config BOARD_TECHNIKABLE
	select SOC_NRF52840_QIAA
	select ZMK_BOARD_COMPAT if BOARD_TECHNIKABLE_NRF52840_ZMK
	imply RETAINED_MEM if BOARD_TECHNIKABLE_NRF52840_ZMK
	imply RETENTION if BOARD_TECHNIKABLE_NRF52840_ZMK
	imply RETENTION_BOOT_MODE if BOARD_TECHNIKABLE_NRF52840_ZMK
